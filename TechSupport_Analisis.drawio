<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-11-09T23:45:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  
  <!-- ========================================================== -->
  <!-- LIENZO UNIFICADO: HOJA DE ANÁLISIS COMPLETA (A1, A2 Y A3)  -->
  <!-- ========================================================== -->
  <diagram id="analisis-completo" name="Análisis Completo (A1, A2, A3)">
    <mxGraphModel dx="1400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========================================================== -->
        <!-- ENCABEZADO GENERAL                                         -->
        <!-- ========================================================== -->
        <mxCell id="banner_gral" value="TECHSUPPORT SOLUTIONS — ENTREGABLE DE ANÁLISIS TÉCNICO&#xa;Mini API de Gestión de Incidentes (.NET 10 · SQLite · EF Core · JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#020617;fontColor=#ffffff;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1100" height="60" as="geometry" />
        </mxCell>

        <!-- ========================================================== -->
        <!-- SECCIÓN A1: DEL PROBLEMA AL REQUERIMIENTO                  -->
        <!-- ========================================================== -->
        <mxCell id="sec_a1_title" value="A1. DEL PROBLEMA AL REQUERIMIENTO (MATRIZ DE TRAZABILIDAD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#38bdf8;fontStyle=1;fontSize=14;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- Cabeceras de tabla -->
        <mxCell id="th_p" value="1. Problema Detectado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#991b1b;strokeColor=#7f1d1d;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="155" width="310" height="35" as="geometry" />
        </mxCell>
        <mxCell id="th_r" value="2. Requerimiento Técnico (Funcionalidad API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#075985;strokeColor=#0c4a6e;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="375" y="155" width="415" height="35" as="geometry" />
        </mxCell>
        <mxCell id="th_v" value="3. Prueba de Validación (Criterio de Éxito)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065f46;strokeColor=#064e3b;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="805" y="155" width="345" height="35" as="geometry" />
        </mxCell>

        <!-- Fila 1 -->
        <mxCell id="row1_p" value="&lt;b&gt;Las solicitudes se pierden&lt;/b&gt;&lt;br&gt;&lt;br&gt;Llegan dispersas por WhatsApp, llamadas y correos sin registro central ni asignación clara." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;fontColor=#991b1b;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="310" height="90" as="geometry" />
        </mxCell>
        <mxCell id="row1_r" value="&lt;b&gt;Centralización en Web API + SQLite&lt;/b&gt;&lt;br&gt;&lt;br&gt;Endpoint &lt;code&gt;POST /api/incidentes&lt;/code&gt; con persistencia relacional en SQLite y asignación automática del estado inicial &lt;b&gt;Pendiente&lt;/b&gt; y timestamp UTC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;fontColor=#0369a1;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="375" y="200" width="415" height="90" as="geometry" />
        </mxCell>
        <mxCell id="row1_v" value="&lt;b&gt;Prueba HTTP 201 Created&lt;/b&gt;&lt;br&gt;&lt;br&gt;Al crear un incidente válido, la API retorna &lt;b&gt;201 Created&lt;/b&gt; con el ID generado y el registro queda persistido en &lt;code&gt;techsupport.db&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;fontColor=#065f46;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="805" y="200" width="345" height="90" as="geometry" />
        </mxCell>

        <!-- Fila 2 -->
        <mxCell id="row2_p" value="&lt;b&gt;Asignaciones poco claras&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dos técnicos atienden lo mismo o incidentes urgentes quedan sin resolver por falta de responsable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;fontColor=#991b1b;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="310" height="90" as="geometry" />
        </mxCell>
        <mxCell id="row2_r" value="&lt;b&gt;Asignación Exclusiva por Administrador&lt;/b&gt;&lt;br&gt;&lt;br&gt;Endpoint &lt;code&gt;PUT /api/incidentes/{id}/asignar&lt;/code&gt; exclusivo para Administrador. Valida que el destinatario tenga rol &lt;b&gt;Tecnico&lt;/b&gt; y avanza el estado a &lt;b&gt;Asignado&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;fontColor=#0369a1;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="375" y="300" width="415" height="90" as="geometry" />
        </mxCell>
        <mxCell id="row2_v" value="&lt;b&gt;Prueba de Integridad de Rol&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Asignar técnico válido actualiza &lt;code&gt;TecnicoId&lt;/code&gt; a estado &lt;b&gt;Asignado&lt;/b&gt;.&lt;br&gt;• Asignar a usuario no-técnico retorna &lt;b&gt;400 Bad Request&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;fontColor=#065f46;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="805" y="300" width="345" height="90" as="geometry" />
        </mxCell>

        <!-- Fila 3 -->
        <mxCell id="row3_p" value="&lt;b&gt;Se consulta información ajena&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cualquier empleado o técnico puede consultar o manipular incidentes que no le pertenecen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;fontColor=#991b1b;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="310" height="95" as="geometry" />
        </mxCell>
        <mxCell id="row3_r" value="&lt;b&gt;Control de Acceso Basado en Propiedad (JWT)&lt;/b&gt;&lt;br&gt;&lt;br&gt;El ID de quien actúa se extrae de los claims del JWT. El Técnico solo ve y modifica sus asignados; el Usuario solo los que creó; el Admin ve todo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;fontColor=#0369a1;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="375" y="400" width="415" height="95" as="geometry" />
        </mxCell>
        <mxCell id="row3_v" value="&lt;b&gt;Prueba de Seguridad 404 Not Found&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Usuario A intentando consultar incidente de Usuario B $\rightarrow$ &lt;b&gt;404 Not Found&lt;/b&gt;.&lt;br&gt;• Técnico A intentando editar incidente de Técnico B $\rightarrow$ &lt;b&gt;404 Not Found&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;fontColor=#065f46;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="805" y="400" width="345" height="95" as="geometry" />
        </mxCell>

        <!-- Fila 4 -->
        <mxCell id="row4_p" value="&lt;b&gt;Errores sin registro / con detalles internos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Excepciones no controladas exponen rutas internas, tablas o stack traces sensibles al cliente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;fontColor=#991b1b;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="505" width="310" height="95" as="geometry" />
        </mxCell>
        <mxCell id="row4_r" value="&lt;b&gt;Middleware Centralizado de Excepciones&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;ExceptionHandlingMiddleware&lt;/code&gt; al inicio del pipeline: captura fallos, registra log con &lt;code&gt;ILogger&lt;/code&gt; y devuelve respuesta 500 controlada con &lt;code&gt;requestId&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;fontColor=#0369a1;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="375" y="505" width="415" height="95" as="geometry" />
        </mxCell>
        <mxCell id="row4_v" value="&lt;b&gt;Prueba 500 Seguro sin Fugas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Endpoint con error intencional responde &lt;b&gt;500 Internal Server Error&lt;/b&gt; con JSON seguro:&lt;br&gt;&lt;code&gt;{ success: false, message, requestId, timestamp }&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;fontColor=#065f46;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="805" y="505" width="345" height="95" as="geometry" />
        </mxCell>

        <!-- ========================================================== -->
        <!-- SECCIÓN A2: DIAGRAMA DE ESTADOS (CICLO DE VIDA)           -->
        <!-- ========================================================== -->
        <mxCell id="sec_a2_title" value="A2. DIAGRAMA DE ESTADOS DEL INCIDENTE (TRANSICIONES VÁLIDAS Y PROHIBIDAS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#38bdf8;fontStyle=1;fontSize=14;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="625" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- Nodo Inicio -->
        <mxCell id="a2_init" value="" style="ellipse;fillColor=#0284c7;strokeColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- Estado 1: Pendiente -->
        <mxCell id="st1" value="&lt;b&gt;1. PENDIENTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Estado inicial al crear.&lt;br&gt;&lt;code&gt;TecnicoId = null&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="680" width="150" height="75" as="geometry" />
        </mxCell>

        <!-- Estado 2: Asignado -->
        <mxCell id="st2" value="&lt;b&gt;2. ASIGNADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Técnico vinculado.&lt;br&gt;&lt;code&gt;TecnicoId = &amp;lt;id&amp;gt;&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#6d28d9;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="680" width="150" height="75" as="geometry" />
        </mxCell>

        <!-- Estado 3: En Proceso -->
        <mxCell id="st3" value="&lt;b&gt;3. EN PROCESO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Técnico inicia la atención activa del caso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#fcd34d;fontColor=#b45309;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="610" y="680" width="150" height="75" as="geometry" />
        </mxCell>

        <!-- Estado 4: Resuelto -->
        <mxCell id="st4" value="&lt;b&gt;4. RESUELTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Solución completada.&lt;br&gt;&lt;code&gt;FechaResolucion = UTC&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;fontColor=#15803d;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="680" width="150" height="75" as="geometry" />
        </mxCell>

        <!-- Estado 5: Cerrado -->
        <mxCell id="st5" value="&lt;b&gt;5. CERRADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conformidad de usuario.&lt;br&gt;&lt;b&gt;Estado Terminal Final&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="810" width="150" height="75" as="geometry" />
        </mxCell>

        <!-- Nodo Fin -->
        <mxCell id="a2_end" value="" style="ellipse;shape=doubleEllipse;fillColor=#334155;strokeColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1050" y="830" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- Transiciones Válidas (Verdes/Azules) -->
        <mxCell id="arr_0_1" value="POST /incidentes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=10;" edge="1" parent="1" source="a2_init" target="st1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_1_2" value="PUT .../asignar&#xa;[Admin asigna Técnico]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=10;" edge="1" parent="1" source="st1" target="st2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_2_3" value="PUT .../estado&#xa;[Técnico o Admin]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=10;" edge="1" parent="1" source="st2" target="st3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_3_4" value="PUT .../estado&#xa;[Técnico o Admin]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=10;" edge="1" parent="1" source="st3" target="st4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_4_5" value="PUT .../estado&#xa;[Admin o Técnico]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=10;" edge="1" parent="1" source="st4" target="st5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_5_end" value="Fin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;fontColor=#475569;fontSize=10;" edge="1" parent="1" source="st5" target="a2_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Transiciones Prohibidas Explícitamente (Rojas Discontinuas) -->
        <mxCell id="arr_proh1" value="⛔ PROHIBIDO: Cerrar sin pasar por Resuelto&#xa;(Retorna 400 Bad Request)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=3;dashed=1;fontColor=#b91c1c;fontStyle=1;fontSize=10;labelBackgroundColor=#fff1f2;" edge="1" parent="1" source="st1" target="st5">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="848" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr_proh2" value="⛔ PROHIBIDO: Reabrir incidente Cerrado&#xa;(Si el problema vuelve, se crea uno nuevo)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=3;dashed=1;fontColor=#b91c1c;fontStyle=1;fontSize=10;labelBackgroundColor=#fff1f2;" edge="1" parent="1" source="st5" target="st3">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="685" y="848" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Cuadro de Reglas de Dominio -->
        <mxCell id="box_domain_rules" value="&lt;b&gt;REGLAS ESTRICTAS DE INTEGRIDAD DEL CICLO DE VIDA:&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Secuencialidad estricta:&lt;/b&gt; El estado solo avanza al siguiente paso (no se admiten saltos).&lt;br&gt;2. &lt;b&gt;Asignación exclusiva:&lt;/b&gt; Solo se asigna a usuarios con rol &lt;i&gt;Tecnico&lt;/i&gt;. Intentar asignar a otro rol retorna 400 Bad Request.&lt;br&gt;3. &lt;b&gt;Resolución auditada:&lt;/b&gt; Al pasar a &lt;i&gt;Resuelto&lt;/i&gt;, se establece automáticamente &lt;code&gt;FechaResolucion&lt;/code&gt;.&lt;br&gt;4. &lt;b&gt;Inmutabilidad final:&lt;/b&gt; Un incidente en estado &lt;i&gt;Cerrado&lt;/i&gt; no se reabre ni se elimina." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;fontColor=#92400e;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="910" width="1100" height="75" as="geometry" />
        </mxCell>

        <!-- ========================================================== -->
        <!-- SECCIÓN A3: DECISIONES DE DISEÑO Y ARQUITECTURA           -->
        <!-- ========================================================== -->
        <mxCell id="sec_a3_title" value="A3. DOS DECISIONES DE DISEÑO Y JUSTIFICACIÓN DE SEGURIDAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#38bdf8;fontStyle=1;fontSize=14;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="1010" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- Tarjeta Decisión 1 -->
        <mxCell id="card_d1_h" value="Decisión 1: Recurso Ajeno (¿403 Forbidden o 404 Not Found?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e40af;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1055" width="535" height="35" as="geometry" />
        </mxCell>
        <mxCell id="card_d1_b" value="&lt;b&gt;Decisión Adoptada:&lt;/b&gt; Responder siempre &lt;b&gt;404 Not Found&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Justificación de Seguridad (1 línea):&lt;/b&gt;&lt;br&gt;Responder 403 confirmaría la existencia del incidente facilitando la &lt;b&gt;enumeración de recursos&lt;/b&gt; (adivinar IDs válidos); con 404 un atacante no puede distinguir si el incidente no existe o si es confidencial." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;fontColor=#1e3a8a;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1090" width="535" height="130" as="geometry" />
        </mxCell>

        <!-- Tarjeta Decisión 2 -->
        <mxCell id="card_d2_h" value="Decisión 2: Eliminación de Incidentes en Estado Cerrado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=#115e59;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="615" y="1055" width="535" height="35" as="geometry" />
        </mxCell>
        <mxCell id="card_d2_b" value="&lt;b&gt;Decisión Adoptada:&lt;/b&gt; &lt;b&gt;No se permite&lt;/b&gt; eliminar incidentes que ya están Cerrados.&lt;br&gt;&lt;br&gt;&lt;b&gt;Justificación de Negocio y Auditoría (1 línea):&lt;/b&gt;&lt;br&gt;Eliminar un incidente cerrado destruiría la &lt;b&gt;trazabilidad histórica y la evidencia de auditoría&lt;/b&gt; (cumplimiento de SLA, tiempos reales de atención y precedentes de fallas técnicas resueltas)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#99f6e4;fontColor=#134e4a;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="615" y="1090" width="535" height="130" as="geometry" />
        </mxCell>

        <!-- ========================================================== -->
        <!-- ARQUITECTURA DE LA SOLUCIÓN (2 PROYECTOS EN TECHSUPPORT.SLNX)-->
        <!-- ========================================================== -->
        <mxCell id="sec_arch_title" value="ARQUITECTURA DE LA SOLUCIÓN (TechSupport.slnx — 2 PROYECTOS DESACOPLADOS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#1e293b;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="1245" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="box_mvc" value="&lt;b&gt;TechSupport.Web&lt;/b&gt;&lt;br&gt;(ASP.NET Core MVC)&lt;br&gt;&lt;br&gt;• Cliente UI / Frontend&lt;br&gt;• Vistas Razor interactivas&lt;br&gt;• &lt;b&gt;SIN conexión a Base de Datos&lt;/b&gt;&lt;br&gt;• Usa &lt;code&gt;HttpClient&lt;/code&gt; hacia la API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="1290" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="arr_mvc_api" value="Peticiones HTTP REST&#xa;(JSON + Bearer JWT)&#xa;POST, GET, PUT, DELETE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="box_mvc" target="box_api_arch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="box_api_arch" value="&lt;b&gt;TechSupport.API&lt;/b&gt; (ASP.NET Core Web API)&lt;br&gt;&lt;br&gt;• &lt;b&gt;Manejo de Errores:&lt;/b&gt; &lt;code&gt;ExceptionHandlingMiddleware&lt;/code&gt; (500 seguro)&lt;br&gt;• &lt;b&gt;Autenticación &amp;amp; Roles:&lt;/b&gt; JWT Bearer + BCrypt&lt;br&gt;• &lt;b&gt;Reglas de Negocio:&lt;/b&gt; Propiedad estricta y máquina de estados&lt;br&gt;• &lt;b&gt;ORM:&lt;/b&gt; Entity Framework Core con doble relación Usuario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#7dd3fc;fontColor=#0369a1;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="1290" width="370" height="150" as="geometry" />
        </mxCell>

